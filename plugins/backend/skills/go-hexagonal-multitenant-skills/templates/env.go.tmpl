// Package env lee la configuracion del entorno. Es el unico lugar del proyecto
// que llama a os.Getenv: leerla en un solo sitio hace que un typo se vea en el
// arranque y no a mitad de un reporte.
package env

import (
	"bufio"
	"os"
	"path/filepath"
	"strconv"
	"strings"
)

// Get devuelve la variable o el valor por defecto si esta vacia.
func Get(key, fallback string) string {
	if value := strings.TrimSpace(os.Getenv(key)); value != "" {
		return value
	}
	return fallback
}

// Int devuelve la variable como entero, o el valor por defecto si no parsea.
func Int(key string, fallback int) int {
	value, err := strconv.Atoi(Get(key, ""))
	if err != nil {
		return fallback
	}
	return value
}

// Bool interpreta 1/t/true (en cualquier caso) como verdadero.
func Bool(key string, fallback bool) bool {
	value, err := strconv.ParseBool(Get(key, ""))
	if err != nil {
		return fallback
	}
	return value
}

// List parte una variable separada por comas, sin vacios ni espacios.
func List(key string) []string {
	raw := Get(key, "")
	if raw == "" {
		return nil
	}
	parts := strings.Split(raw, ",")
	out := make([]string, 0, len(parts))
	for _, part := range parts {
		if trimmed := strings.TrimSpace(part); trimmed != "" {
			out = append(out, trimmed)
		}
	}
	return out
}

// LoadDotEnv carga un .env si existe. Pensado para cmd/local: en Lambda no hay
// archivo y mandan las variables de la funcion. Las variables ya definidas en
// el entorno tienen prioridad y no se pisan.
//
// Si la ruta es relativa se busca hacia arriba unos niveles, porque los
// binarios se corren desde subdirectorios (`go run ./cmd/local`).
func LoadDotEnv(path string) {
	resolved, found := findUpwards(path)
	if !found {
		return
	}
	file, err := os.Open(resolved)
	if err != nil {
		return
	}
	defer file.Close()

	scanner := bufio.NewScanner(file)
	for scanner.Scan() {
		key, value, ok := parseLine(scanner.Text())
		if !ok {
			continue
		}
		if _, exists := os.LookupEnv(key); exists {
			continue
		}
		_ = os.Setenv(key, value)
	}
}

const maxDepth = 4

func findUpwards(path string) (string, bool) {
	if filepath.IsAbs(path) {
		_, err := os.Stat(path)
		return path, err == nil
	}
	directory, err := os.Getwd()
	if err != nil {
		return "", false
	}
	for range maxDepth {
		candidate := filepath.Join(directory, path)
		if _, err := os.Stat(candidate); err == nil {
			return candidate, true
		}
		parent := filepath.Dir(directory)
		if parent == directory {
			break
		}
		directory = parent
	}
	return "", false
}

func parseLine(raw string) (key, value string, ok bool) {
	line := strings.TrimSpace(raw)
	if line == "" || strings.HasPrefix(line, "#") {
		return "", "", false
	}
	line = strings.TrimPrefix(line, "export ")
	key, value, found := strings.Cut(line, "=")
	if !found {
		return "", "", false
	}
	key = strings.TrimSpace(key)
	if key == "" {
		return "", "", false
	}
	value = strings.TrimSpace(value)
	if len(value) >= 2 {
		first, last := value[0], value[len(value)-1]
		if (first == '"' && last == '"') || (first == '\'' && last == '\'') {
			value = value[1 : len(value)-1]
		}
	}
	return key, value, true
}
